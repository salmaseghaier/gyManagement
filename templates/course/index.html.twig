{% extends 'base.html.twig' %}

{% block title %}Course List{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Course List</h1>
        <div class="d-flex justify-content-between mb-3">
            <a href="{{ path('admin_course_new') }}" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create New Course
            </a>
        </div>

        <div class="row">
            {% for course in courses %}
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm">
                        <div class="card-header">
                            <h5 class="card-title">{{ course.title }}</h5>
                        </div>
                        <div class="card-body">
                            <p class="card-text">{{ course.description ? course.description : 'No description available.' }}</p>
                            <p class="card-text"><strong>Schedule:</strong> {{ course.schedule ? course.schedule|date('Y-m-d H:i:s') : 'Not Scheduled' }}</p>
                        </div>
                        <div class="card-footer text-muted d-flex justify-content-between">
                            <a href="{{ path('admin_course_edit', {'id': course.id}) }}" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            {{ include('course/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            {% else %}
                <p>No courses available.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
